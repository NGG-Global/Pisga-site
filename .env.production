# Connection settings used by every production build (`npm run build`), including the
# Cloudflare deployment.
#
# ONLY PUBLIC VALUES BELONG IN THIS FILE. It is committed to the repository, and its values
# are embedded in the files sent to every visitor's browser in any case. The Supabase URL and
# the PUBLISHABLE key are public by design; row-level security is what protects the data.
# NEVER put the Supabase secret key, a database password or any other secret here.
#
# A build variable of the same name set in the Cloudflare dashboard takes priority over this
# file, which is how a separate production project can be introduced later.
VITE_SUPABASE_URL=https://omexwbyzoguitxbanlln.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_wqEoU96D5ILWyjSdSm6Nbw_4tsH-uWH
VITE_DEMO_MODE=false
