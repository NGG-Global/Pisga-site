# Copy to .env.local for local work. Production builds take their values from
# .env.production, or from build variables of the same name in the Cloudflare dashboard,
# which take priority. Only VITE_* values reach the browser.

# Supabase project URL and PUBLISHABLE key (never the secret key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Demo mode runs the app on sample data held in the browser, with no backend.
# It must be "false" (or absent) on the production deployment.
VITE_DEMO_MODE=false
