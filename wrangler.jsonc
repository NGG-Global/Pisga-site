// Cloudflare Worker that serves the built site as static assets (no server code).
// Used by Workers Builds, which is connected to this repository. The name must stay equal
// to the Worker's name in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pisga-site",
  "compatibility_date": "2026-11-19",
  // Wrangler runs this before it reads the assets directory, so `npx wrangler deploy` produces
  // dist/ by itself, installing dependencies first when they are missing. It is a safety net
  // for a deployment whose dashboard has no build command.
  "build": { "command": "node scripts/cloudflare-build.mjs" },
  // Required by `npx wrangler preview`, the command Cloudflare runs for every branch that is
  // not the production branch. Empty, because a preview needs no settings of its own.
  "previews": {},
  "assets": {
    // Output of `npm run build`. Security and caching headers come from dist/_headers.
    "directory": "./dist",
    // Every path that is not a file is answered with the app, so links such as /sessions/3 work.
    "not_found_handling": "single-page-application"
  }
}
